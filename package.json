{
  "name": "@obinexusltd/pypolycall",
  "version": "1.1.0",
  "description": "npm distribution of the pypolycall Python sources (not a Node binding; install the Python package with pip: python -m pip install pypolycall)",
  "main": "index.js",
  "type": "commonjs",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./dist/*": "./dist/*",
    "./examples/*": "./examples/*",
    "./tests/*": "./tests/*"
  },
  "files": [
    "index.js",
    "dist/",
    "src/",
    "examples/",
    "tests/",
    "pyproject.toml",
    "pypolycallrc",
    "polycall-binding.json",
    "README.md",
    "TODO.md",
    "LICENSE",
    "core/",
    "CMakeLists.txt",
    "scripts/"
  ],
  "directories": {
    "lib": "src",
    "src": "src",
    "dist": "dist",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "build:python": "python -m build --outdir dist",
    "test": "node tests/package.test.js && python -m pytest -q tests",
    "test:package": "node tests/package.test.js",
    "test:python": "python -m pytest -q tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/pypolycall.git"
  },
  "keywords": [
    "libpolycall",
    "polycall",
    "python",
    "ctypes",
    "ffi"
  ],
  "author": "Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/obinexus/pypolycall/issues"
  },
  "homepage": "https://github.com/obinexus/pypolycall#readme"
}
